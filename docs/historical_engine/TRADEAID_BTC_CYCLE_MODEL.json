  "owner": "CRYPTOAID_TRADE_AI",
  "component": "BtcCycleClassifier",
  "purpose": "Modello tassonomico empirico per i regimi e le fasi di ciclo di Bitcoin, basato su indicatori quantitativi continui e non su assunzioni a priori.",
  "invariants": [
    "Nessun ciclo passato è assunto identico a quello attuale",
    "Gli halving sono trattati come marker temporali di contesto, non come cause meccaniche certe",
    "Tutte le metriche di drawdown e rolling return usano esclusivamente dati <= T",
    "I cambi di regime richiedono conferme su finestre multiple per evitare 'whipsaws'"
  ],
  "cycle_phases_taxonomy": [
    {
      "phase": "ACCUMULATION",
      "characteristics": ["Drawdown > 50% from ATH", "Volatility 30d below historical median", "Price consolidating within narrow band", "Breadth depressed"]
    },
    {
      "phase": "EARLY_BULL",
      "characteristics": ["Price cross above SMA200", "Higher highs over 90d window", "Market breadth expanding above 0.50", "Halving proximity window [-180d, +180d]"]
    },
    {
      "phase": "BULL_EXPANSION",
      "characteristics": ["Return 90d > +50%", "Price > SMA50 > SMA200", "Volume expansion", "Altcoin participation broadening"]
    },
    {
      "phase": "EUPHORIA",
      "characteristics": ["Price breaking previous ATH", "RSI 14d > 80 sustained", "Volatility expansion upwards", "Retail search / social volume spike"]
    },
    {
      "phase": "DISTRIBUTION",
      "characteristics": ["Lower highs with elevated volume", "Bearish divergences on daily momentum", "BTC dominance flattening/falling", "High dispersion across Top-200"]
    },
    {
      "phase": "BEAR",
      "characteristics": ["Price cross below SMA200", "Return 90d < -20%", "Lower highs and lower lows", "Institutional/retail outflow"]
    },
    {
      "phase": "CAPITULATION",
      "characteristics": ["Rapid drawdown (> 20% in < 7d)", "Extreme volume spike on downward candles", "RSI 14d < 20", "Funding rates deeply negative / liquidation cascades"]
    },
    {
      "phase": "RECOVERY",
      "characteristics": ["Stabilization post-capitulation", "RSI divergence recovery from oversold", "Declining downward momentum", "Mean reversion towards SMA50"]
    },
    {
      "phase": "RANGE_BOUND",
      "characteristics": ["Price oscillating between clear support/resistance levels (+/- 10%)", "No trend on SMA50 slope", "Low directional conviction"]
    },
    {
      "phase": "VOLATILITY_COMPRESSION",
      "characteristics": ["Bollinger band width at 6-month lows", "ATR 14d relative to price at bottom decile", "Precursor to directional breakout"]
    },
    {
      "phase": "VOLATILITY_EXPANSION",
      "characteristics": ["Sharp increase in daily true range (> 2x 30d median)", "Break of multi-week range boundaries"]
    }
  ],
  "halving_context_markers": {
