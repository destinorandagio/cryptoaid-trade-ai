  "symbol_resolution_function": {
    "signature": "resolve_canonical_asset_id(symbol: str, target_date: date) -> str",
    "algorithm": [
      "1. Query asset_symbol_aliases where symbol == input_symbol and (valid_from <= target_date or valid_from is null) and (valid_to >= target_date or valid_to is null)",
      "2. If exact match found: return canonical_asset_id",
      "3. If multiple matches: disambiguate through asset_identity_events timeline effective at target_date",
      "4. If no match found: raise UnknownHistoricalAssetError(symbol, target_date)"
    ]
  }
